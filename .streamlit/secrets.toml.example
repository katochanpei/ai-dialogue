# Streamlit Cloud デプロイ時に設定する secrets のテンプレート。
# 実ファイルは `.streamlit/secrets.toml` で、.gitignore で除外されます。
#
# ローカルでこのファイルを使う場合は:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# して値を埋める。
#
# Streamlit Cloud では https://share.streamlit.io のアプリ設定画面で
# 同じ内容を貼り付ける。

GEMINI_API_KEY = "your-gemini-api-key-here"
APP_PASSWORD = "your-app-password-here"

# クラウド共有モード（複数人で使う時）。
# true にすると:
#   - サイドバーから過去ログ一覧を非表示
#   - ディスクへのログ保存もスキップ（プライバシー保護）
#   - 議論直後の「ダウンロード」ボタンからのみ取得可能
# ローカル単独で使うなら false / 未設定でOK
MULTI_USER_MODE = "true"
